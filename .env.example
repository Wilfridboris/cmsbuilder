# SnapBusy environment variables — PLACEHOLDERS ONLY.
# Copy to `.env.local` for development and fill in real values there.
# `.env.local`, `.env*.local`, and `.env.production` are git-ignored and must
# never be committed with real secrets.

# ---------------------------------------------------------------------------
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_, never import in client
# components or client hooks. SUPABASE_SERVICE_ROLE_KEY in particular is
# blocked from client-bundled code by the ESLint CI gate.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_METERED_PRICE_ID=price_your_metered_price_id
CRON_SECRET=your-cron-shared-secret
RESEND_API_KEY=re_your_resend_api_key
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ---------------------------------------------------------------------------
# Client-safe values — exposed to the browser bundle (NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project
