# Scheza environment variables — PLACEHOLDERS ONLY.
# Copy to `.env.local` for development and fill in real values there.
# `.env.local`, `.env*.local`, and `.env.production` are git-ignored and must
# never be committed with real secrets.

# ---------------------------------------------------------------------------
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_, never import in client
# components or client hooks. SUPABASE_SERVICE_ROLE_KEY in particular is
# blocked from client-bundled code by the ESLint CI gate.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# HMAC secret that signs the anonymous /api/generate session cookie (Story 1.4).
GENERATE_SESSION_SECRET=your-generate-session-signing-secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Fixed monthly Stripe price id per flat tier (Story 7.2). Checkout runs in
# subscription mode at these prices; there is NO metered/usage component.
STRIPE_PRICE_SOLO=price_your_solo_price_id
STRIPE_PRICE_CREW=price_your_crew_price_id
STRIPE_PRICE_SHOP=price_your_shop_price_id
CRON_SECRET=your-cron-shared-secret
RESEND_API_KEY=re_your_resend_api_key
# Verified sender for transactional invoice emails (Story 12.6). e.g. "Scheza <invoices@scheza.com>".
RESEND_FROM_EMAIL=invoices@your-domain.com
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ---------------------------------------------------------------------------
# Client-safe values — exposed to the browser bundle (NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project

# ---------------------------------------------------------------------------
# RLS isolation test — the dedicated ca-central-1 Supabase TEST project only
# (never production). Read by `npm run test:rls` and the CI RLS gate. In CI
# these come from GitHub repository secrets; locally, put them in a git-ignored
# `.env.test.local`. The service-role key is used solely inside the test to
# seed orgs/users and never reaches a client bundle.
# ---------------------------------------------------------------------------
SUPABASE_TEST_URL=https://your-test-project.supabase.co
SUPABASE_TEST_ANON_KEY=your-test-project-anon-key
SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-project-service-role-key
